# ---- MQTT Broker connection ----
# If you're relaying from ThingSpeak's MQTT broker:
#   MQTT_BROKER_URL=mqtts://mqtt3.thingspeak.com:8883
#   MQTT_USERNAME=<your ThingSpeak MQTT username (Client ID)>
#   MQTT_PASSWORD=<your ThingSpeak MQTT password (MQTT API Key)>
#   MQTT_TOPIC=channels/<CHANNEL_ID>/subscribe/fields/#
#
# If you're relaying from your own broker (e.g. HiveMQ Cloud, Mosquitto)
# that the ESP32 already publishes to directly:
#   MQTT_BROKER_URL=mqtts://<your-broker-host>:8883
#   MQTT_USERNAME=<broker username>
#   MQTT_PASSWORD=<broker password>
#   MQTT_TOPIC=smartcyl/sensors

MQTT_BROKER_URL=mqtts://mqtt3.thingspeak.com:8883
MQTT_USERNAME=your_client_id
MQTT_PASSWORD=your_mqtt_api_key
MQTT_TOPIC=channels/your_channel_id/subscribe/fields/+

# ---- Relay server config ----
PORT=3000

# Comma-separated list of origins allowed to call the REST/WS API.
# Use * for testing, restrict to your dashboard's domain in production.
ALLOWED_ORIGINS=*

# How many historical readings to keep in memory for the /api/history endpoint
HISTORY_BUFFER_SIZE=200
